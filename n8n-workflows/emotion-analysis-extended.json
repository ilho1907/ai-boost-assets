      "id": "text-emotion",
      "name": "Metin Duygu Analizi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 740]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst emotionLabelsDE = {\n  'happy':'Freude','joy':'Freude','sad':'Trauer','sadness':'Trauer',\n  'angry':'Wut','anger':'Wut','fear':'Angst','disgust':'Ekel',\n  'surprise':'Überraschung','neutral':'Neutral','contempt':'Verachtung',\n  'calm':'Ruhe','confused':'Verwirrt','excited':'Aufgeregt'\n};\nconst negativeEmotions = ['angry','anger','fear','sad','sadness','disgust','contempt'];\nconst positiveEmotions = ['happy','joy','excited','calm','surprise'];\nconst results = [];\nfor (const item of items) {\n  const raw = item.json;\n  let emotions = {};\n  const providers = ['ibm','amazon','microsoft','google'];\n  for (const p of providers) {\n    if (raw[p]?.items) raw[p].items.forEach(e => {\n      if (e.emotion) emotions[e.emotion.toLowerCase()] = Math.max(emotions[e.emotion.toLowerCase()]||0, e.confidence||0);\n    });\n    if (raw[p]?.faces) raw[p].faces.forEach(face => {\n      (face.emotions||[]).forEach(e => {\n        const k = e.emotion?.toLowerCase();\n        if (k) emotions[k] = Math.max(emotions[k]||0, e.confidence||0);\n      });\n    });\n  }\n  let dominantEmotion = 'neutral', confidence = 0;\n  if (Object.keys(emotions).length > 0)\n    [dominantEmotion, confidence] = Object.entries(emotions).sort((a,b)=>b[1]-a[1])[0];\n  const isNegative = negativeEmotions.includes(dominantEmotion);\n  const isPositive = positiveEmotions.includes(dominantEmotion);\n  const alert = confidence > 0.65 && isNegative;\n  results.push({\n    timestamp: new Date().toISOString(),\n    scenario: raw._scenario || $('Webhook Giriş').item.json.body.scenario || 'general',\n    customerName: $('Webhook Giriş').item.json.body.customerName || 'Unbekannt',\n    customerId: $('Webhook Giriş').item.json.body.customerId || '',\n    dominantEmotion, dominantEmotionDE: emotionLabelsDE[dominantEmotion]||dominantEmotion,\n    confidence: Math.round(confidence*100)/100,\n    allEmotions: emotions,\n    polarity: isPositive?'positiv':isNegative?'negativ':'neutral',\n    alert,\n    alertLevel: alert&&confidence>0.85?'KRITISCH':alert?'WARNUNG':'OK',\n    mediaType: $('Webhook Giriş').item.json.body.type || 'unknown'\n  });\n}\nreturn results;"
      },
