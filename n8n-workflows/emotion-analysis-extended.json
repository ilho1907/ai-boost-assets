      "id": "text-emotion",
      "name": "Metin Duygu Analizi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 720]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst results = [];\n\nconst emotionLabelsDE = {\n  'happy': 'Freude', 'joy': 'Freude',\n  'sad': 'Trauer', 'sadness': 'Trauer',\n  'angry': 'Wut', 'anger': 'Wut',\n  'fear': 'Angst', 'disgust': 'Ekel',\n  'surprise': 'Überraschung', 'neutral': 'Neutral',\n  'contempt': 'Verachtung', 'calm': 'Ruhe',\n  'confused': 'Verwirrt', 'excited': 'Aufgeregt'\n};\n\nconst negativeEmotions = ['angry','anger','fear','sad','sadness','disgust','contempt'];\nconst positiveEmotions = ['happy','joy','excited','calm','surprise'];\n\nfor (const item of items) {\n  const raw = item.json;\n  let emotions = {};\n\n  // Metin duygu formatı (IBM/Amazon NLP)\n  const providers = ['ibm','amazon','microsoft','google'];\n  for (const p of providers) {\n    if (raw[p]?.items) {\n      raw[p].items.forEach(e => {\n        if (e.emotion) {\n          emotions[e.emotion.toLowerCase()] = Math.max(\n            emotions[e.emotion.toLowerCase()] || 0,\n            e.confidence || 0\n          );\n        }\n      });\n    }\n    // Yüz duygu formatı\n    if (raw[p]?.faces) {\n      raw[p].faces.forEach(face => {\n        (face.emotions || []).forEach(e => {\n          const key = e.emotion?.toLowerCase();\n          if (key) emotions[key] = Math.max(emotions[key] || 0, e.confidence || 0);\n        });\n      });\n    }\n  }\n\n  let dominantEmotion = 'neutral';\n  let confidence = 0;\n  if (Object.keys(emotions).length > 0) {\n    [dominantEmotion, confidence] = Object.entries(emotions)\n      .sort((a, b) => b[1] - a[1])[0];\n  }\n\n  const isNegative = negativeEmotions.includes(dominantEmotion);\n  const isPositive = positiveEmotions.includes(dominantEmotion);\n  const alert = confidence > 0.65 && isNegative;\n\n  // Senaryo belirleme\n  const scenario = raw._scenario || 'general';\n  \n  results.push({\n    timestamp: new Date().toISOString(),\n    scenario,\n    customerName: raw._customerName || 'Unbekannt',\n    customerId: raw._customerId || '',\n    dominantEmotion,\n    dominantEmotionDE: emotionLabelsDE[dominantEmotion] || dominantEmotion,\n    confidence: Math.round(confidence * 100) / 100,\n    allEmotions: emotions,\n    polarity: isPositive ? 'positiv' : isNegative ? 'negativ' : 'neutral',\n    alert,\n    alertLevel: alert && confidence > 0.85 ? 'KRITISCH' : alert ? 'WARNUNG' : 'OK'\n  });\n}\n\nreturn results;"
      },
