      "id": "direct-text-emotion",
      "name": "Direkt Metin Duygu Analizi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 660]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Tüm modalitelerden gelen sonuçları normalize et\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const raw = item.json;\n  const sourceType = item.json._sourceType || 'unknown';\n  \n  // Duygu skorlarını normalize et (0-1 arası)\n  let emotions = {};\n  let dominantEmotion = '';\n  let confidence = 0;\n  \n  // Eden AI Metin Duygu formatı\n  if (raw.ibm || raw.amazon) {\n    const provider = raw.ibm || raw.amazon;\n    if (provider.items) {\n      provider.items.forEach(item => {\n        if (item.emotion) {\n          emotions[item.emotion] = (emotions[item.emotion] || 0) + item.confidence;\n        }\n      });\n    }\n  }\n  \n  // Eden AI Yüz Duygu formatı\n  if (raw.amazon?.faces || raw.google?.faces) {\n    const faces = raw.amazon?.faces || raw.google?.faces || [];\n    faces.forEach(face => {\n      if (face.emotions) {\n        face.emotions.forEach(e => {\n          emotions[e.emotion?.toLowerCase()] = Math.max(\n            emotions[e.emotion?.toLowerCase()] || 0,\n            e.confidence || 0\n          );\n        });\n      }\n    });\n  }\n  \n  // En baskın duyguyu bul\n  if (Object.keys(emotions).length > 0) {\n    dominantEmotion = Object.entries(emotions)\n      .sort((a, b) => b[1] - a[1])[0][0];\n    confidence = emotions[dominantEmotion];\n  }\n  \n  // Almanca duygu etiketleri\n  const emotionLabelsDE = {\n    'happy': 'Freude',\n    'joy': 'Freude',\n    'sad': 'Trauer',\n    'sadness': 'Trauer',\n    'angry': 'Wut',\n    'anger': 'Wut',\n    'fear': 'Angst',\n    'disgust': 'Ekel',\n    'surprise': 'Überraschung',\n    'neutral': 'Neutral',\n    'contempt': 'Verachtung',\n    'calm': 'Ruhe'\n  };\n  \n  results.push({\n    timestamp: new Date().toISOString(),\n    sourceType,\n    dominantEmotion,\n    dominantEmotionDE: emotionLabelsDE[dominantEmotion] || dominantEmotion,\n    confidence: Math.round(confidence * 100) / 100,\n    allEmotions: emotions,\n    rawProviderData: raw,\n    alert: confidence > 0.7 && ['angry', 'anger', 'fear', 'sad', 'sadness'].includes(dominantEmotion)\n  });\n}\n\nreturn results;"
      },
