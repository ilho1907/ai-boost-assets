        "jsonBody": "={\n  \"providers\": \"openai\",\n  \"text\": \"Analysiere folgende Emotion und gib eine kurze professionelle Empfehlung auf Deutsch: Erkannte Emotion: {{ $json.dominantEmotionDE }}, Konfidenz: {{ $json.confidence }}, Alle Emotionen: {{ JSON.stringify($json.allEmotions) }}. Max 3 Sätze.\",\n  \"chatbot_global_action\": \"Du bist ein Experte für Emotionsanalyse und psychologisches Wohlbefinden.\",\n  \"previous_history\": [],\n  \"temperature\": 0.3,\n  \"max_tokens\": 200,\n  \"language\": \"de\"\n}",
        "options": {}
